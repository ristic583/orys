{
  "name": "orys",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "probe": "tsx scripts/probe-claude.ts",
    "test": "vitest run --exclude \"tests/live/**\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "build": "tsc --noEmit && tsc --noEmit -p web && vite build --config web/vite.config.ts",
    "db:generate": "drizzle-kit generate",
    "test:live": "AIPM_LIVE=1 vitest run tests/live",
    "orys": "tsx src/cli/index.ts",
    "aipm": "tsx src/cli/index.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "demo:snapshot": "tsx scripts/demo-snapshot.ts",
    "build:demo": "VITE_ORYS_DEMO=1 vite build --config web/vite.config.ts --outDir dist-demo"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.1.0",
    "drizzle-orm": "^0.45.4",
    "execa": "^10.2.1",
    "fastify": "^5.12.8",
    "ulid": "^3.0.2",
    "ws": "^8.22.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "marked": "^18.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.37.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
}
